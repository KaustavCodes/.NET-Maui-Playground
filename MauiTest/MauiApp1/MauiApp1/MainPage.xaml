<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1"
             xmlns:controls="clr-namespace:MauiApp1.CustomControls"
             xmlns:shared="clr-namespace:MauiApp1.Shared;assembly=MauiApp1.Shared"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:bottomSheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
             x:Class="MauiApp1.MainPage"
             BackgroundColor="#B9A9D5"
             NavigationPage.HasNavigationBar="False">   <!-- base color shows through the transparent edges -->

    <Grid SafeAreaEdges="None">

        <skia:SKCanvasView x:Name="MeshCanvas"
                           PaintSurface="OnMeshPaintSurface"
                           IgnorePixelScaling="True"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           InputTransparent="True" />

        <!-- ========== Main Scrollable Content ========== -->
        <ScrollView VerticalOptions="Fill">
            <VerticalStackLayout Padding="30,60,30,30" Spacing="20">
                <Image Source="dotnet_bot.png"
                       SemanticProperties.Description="Cute dotnet bot waving hi to you!"
                       HeightRequest="160" />

                <Label Text="This is a slider"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <!-- Custom Overlay Searchable Dropdown 1: Simple Strings (Floats over content) -->
                <controls:SearchableDropdown Title="1. Select Country (Strings)"
                                            Placeholder="Search and choose a country..."
                                            ItemsSource="{Binding Countries}"
                                            SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                            ZIndex="20" />

                <Label Text="{Binding SelectedCountry, StringFormat='Selected Country: {0}'}"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#FFE082"
                       HorizontalOptions="Center" />

                

                <Label Text="{Binding SelectedTechnology, StringFormat='Selected Technology: {0}'}"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#A5D6A7"
                       HorizontalOptions="Center" />

                <BoxView HeightRequest="1" Color="#FFFFFF" Opacity="0.3" Margin="0,10" />

                <Label Text="{Binding UserName}"
                       FontSize="28"
                       TextColor="{DynamicResource FunkyColor}"
                       HorizontalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />
                
                <Entry x:Name="myTextbox" Text="{Binding UserName}" />

                <Label Text="Welcome to .NET Multi-platform App UI"
                       FontSize="16"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       SemanticProperties.HeadingLevel="Level2" />

                <BlazorWebView x:Name="BlazorWebView" HostPage="wwwroot/index.html"
                               HeightRequest="250"
                               VerticalOptions="FillAndExpand">
                    <BlazorWebView.RootComponents>
                        <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
                    </BlazorWebView.RootComponents>
                </BlazorWebView>
                
                <!-- Custom Overlay Searchable Dropdown 2: Complex Objects (Floats over content) -->
                <controls:SearchableDropdown Title="2. Select Technology (Objects)"
                                            Placeholder="Search framework or stack..."
                                            DisplayMemberPath="Title"
                                            ItemsSource="{Binding Technologies}"
                                            SelectedItem="{Binding SelectedTechnology, Mode=TwoWay}"
                                            ZIndex="10" />

                <Button x:Name="ShowBottomSheetButton"
                        Text="Show Bottom Sheet"
                        SemanticProperties.Hint="Counts the number of times you click"
                        Clicked="OnBottomSheetButtonClicked"
                        HorizontalOptions="Center" 
                        TextColor="Gray" BorderColor="Yellow"
                        BorderWidth="1" CornerRadius="10"
                        BackgroundColor="White" />
                
                <ImageButton x:Name="bioMetricsButton" Source="identification.png"
                             Clicked="BioMetricsButton_OnClicked"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"></ImageButton>
                
                <Label Text="{Binding CurrentThemeName}" />
                
                <Button x:Name="ToggleTheeme" Clicked="ToggleTheeme_Clicked" Text="Toggle Theme" />
                
                <Button Clicked="Button_OnClicked" Text="Goto Todo Screen" />

                <Button Clicked="Button_Clicked" Text="Go to Echoes Screen" />

                <Button x:Name="GotoGreeting" Clicked="GotoGreeting_Clicked" Text="Go to Greeting Page" />

                <Button x:Name="GoToColour" Clicked="GoToColour_Clicked" Text="Go to Colour Slider Page" />

                <Button x:Name="GoToTip" Clicked="GoToTip_Clicked" Text="Go to Tip Screen" />
            </VerticalStackLayout>
        </ScrollView>

        <bottomSheet:SfBottomSheet x:Name="bottomSheet" CornerRadius="15, 15, 0, 0" HalfExpandedRatio="0.35" ContentPadding="10"
                                   StateChanged="BottomSheet_OnStateChanged">
            <bottomSheet:SfBottomSheet.BottomSheetContent>
                <VerticalStackLayout Spacing="5" x:Name="bottomSheetContent">
                    <Label Text="Bottom Sheet Content" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="This is the content of the bottom sheet. You can add any controls here." FontSize="16" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </bottomSheet:SfBottomSheet.BottomSheetContent>
        </bottomSheet:SfBottomSheet>
    </Grid>
</ContentPage>