<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1.CustomControls"
             x:Class="MauiApp1.CustomControls.SearchableDropdown"
             x:Name="RootDropdown">

    <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
        <!-- Optional Title Label -->
        <Label Text="{Binding ViewModel.Title, Source={x:Reference RootDropdown}}"
               IsVisible="{Binding ViewModel.HasTitle, Source={x:Reference RootDropdown}}"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#FFFFFF"
               Margin="0,0,0,4" />

        <!-- Main Selector Bar Container -->
        <Border x:Name="SelectorBorder"
                StrokeShape="RoundRectangle 12"
                Stroke="#E0E0E0"
                StrokeThickness="1.5"
                BackgroundColor="#FFFFFF"
                Padding="14,0"
                HeightRequest="48"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ViewModel.ToggleDropdownCommand, Source={x:Reference RootDropdown}}" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                <!-- Display Text (Placeholder or Selected Item) -->
                <Label Grid.Column="0"
                       Text="{Binding ViewModel.SelectedItemDisplayText, Source={x:Reference RootDropdown}}"
                       FontSize="15"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ViewModel.HasSelectedItem, Source={x:Reference RootDropdown}}" Value="False">
                            <Setter Property="TextColor" Value="#8E8E93" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding ViewModel.HasSelectedItem, Source={x:Reference RootDropdown}}" Value="True">
                            <Setter Property="TextColor" Value="#1C1C1E" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <!-- Clear Selection Button -->
                <Label Grid.Column="1"
                       Text="✕"
                       FontSize="14"
                       TextColor="#8E8E93"
                       VerticalOptions="Center"
                       Padding="6"
                       IsVisible="{Binding ViewModel.HasSelectedItem, Source={x:Reference RootDropdown}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewModel.ClearSelectionCommand, Source={x:Reference RootDropdown}}" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Dropdown Chevron Icon -->
                <Label Grid.Column="2"
                       FontSize="12"
                       TextColor="#555566"
                       VerticalOptions="Center"
                       HorizontalOptions="End">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ViewModel.IsDropdownOpen, Source={x:Reference RootDropdown}}" Value="False">
                            <Setter Property="Text" Value="▼" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding ViewModel.IsDropdownOpen, Source={x:Reference RootDropdown}}" Value="True">
                            <Setter Property="Text" Value="▲" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
