<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="MauiApp1.TodoScreen"
             BackgroundColor="{AppThemeBinding Light=#f8fafc, Dark=#09090b}">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="{mi:Material Icon=Add}"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- ===== Animated Background Orbs ===== -->
        <Ellipse x:Name="Orb1"
                 WidthRequest="320"
                 HeightRequest="320"
                 Fill="#8b5cf6"
                 Opacity="0.35"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-100,-80,0"
                 InputTransparent="True" />

        <Ellipse x:Name="Orb2"
                 WidthRequest="260"
                 HeightRequest="260"
                 Fill="#3b82f6"
                 Opacity="0.30"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 Margin="-100,0,0,80"
                 InputTransparent="True" />

        <Ellipse x:Name="Orb3"
                 WidthRequest="180"
                 HeightRequest="180"
                 Fill="#ec4899"
                 Opacity="0.28"
                 HorizontalOptions="End"
                 VerticalOptions="End"
                 Margin="0,0,20,-40"
                 InputTransparent="True" />

        <!-- Decorative rotating ring -->
        <Border x:Name="RotatingRing"
                WidthRequest="500"
                HeightRequest="500"
                StrokeThickness="1.5"
                Stroke="{AppThemeBinding Light=#6366f133, Dark=#8b5cf626}"
                BackgroundColor="Transparent"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                InputTransparent="True">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="250" />
            </Border.StrokeShape>
        </Border>

        <!-- ===== Main Content ===== -->
        <VerticalStackLayout Padding="28,16"
                             Spacing="0"
                             VerticalOptions="FillAndExpand">

            <!-- Top Section -->
            <VerticalStackLayout Margin="0,20,0,0">
                <Label Text="REACT NATIVE → MAUI"
                       FontSize="13"
                       FontAttributes="Bold"
                       CharacterSpacing="1.5"
                       TextColor="{AppThemeBinding Light=#64748b, Dark=#94a3b8}"
                       Margin="0,0,0,12" />

                <Label Text="Beautiful&#10;Motion"
                       FontSize="42"
                       FontAttributes="Bold"
                       LineHeight="1.1"
                       TextColor="{AppThemeBinding Light=#0f172a, Dark=#f8fafc}"
                       Margin="0,0,0,12" />

                <Label Text="Smooth animations with a modern native feel"
                       FontSize="17"
                       TextColor="{AppThemeBinding Light=#64748b, Dark=#94a3b8}"
                       LineHeight="1.4" />
            </VerticalStackLayout>

            <BoxView HeightRequest="40" Color="Transparent" />

            <!-- Interactive Card -->
            <Border x:Name="MainCard"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#fffffff5, Dark=#18181bf5}"
                    Padding="26"
                    Margin="0,10"
                    Stroke="{AppThemeBinding Light=Transparent, Dark=#ffffff0f}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,20"
                            Radius="30"
                            Opacity="0.12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0" x:Name="PulsingBox">
                    <!-- Card Header -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                        <Border BackgroundColor="{AppThemeBinding Light=#e0e7ff, Dark=#312e81}"
                                Padding="10,5"
                                HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="ACTIVE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.5"
                                   TextColor="{AppThemeBinding Light=#4338ca, Dark=#a5b4fc}" />
                        </Border>

                        <Label Grid.Column="1"
                               Text="Just now"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#94a3b8, Dark=#94a3b8}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="Fluid Interactions"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0f172a, Dark=#f8fafc}"
                           Margin="0,0,0,10" />

                    <Label Text="Press and hold this card to feel the spring animation. Everything here is driven by MAUI animations."
                           FontSize="15"
                           LineHeight="1.5"
                           TextColor="{AppThemeBinding Light=#64748b, Dark=#94a3b8}"
                           Margin="0,0,0,22" />

                    <!-- Progress bar -->
                    <Grid HeightRequest="5">
                        <Border BackgroundColor="{AppThemeBinding Light=#0000000f, Dark=#ffffff14}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                        </Border>

                        <Border WidthRequest="180"
                                HorizontalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light=#6366f1, Dark=#818cf8}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="30" Color="Transparent" />

            <!-- Buttons -->
            <VerticalStackLayout Spacing="12" Margin="0,0,0,12">
                <Button Text="Continue"
                        HeightRequest="56"
                        CornerRadius="18"
                        BackgroundColor="#6366f1"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        Clicked="Button_OnClicked" />

                <Button Text="Explore"
                        HeightRequest="56"
                        CornerRadius="18"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light=#0000001a, Dark=#ffffff1f}"
                        BorderWidth="1.5"
                        TextColor="{AppThemeBinding Light=#0f172a, Dark=#f8fafc}"
                        FontAttributes="Bold"
                        FontSize="16"
                        Clicked="Button_OnClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Grid>
</ContentPage>